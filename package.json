{
  "name": "vps-comparison",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:browser": "playwright test",
    "test": "npm run test:unit && npm run test:browser",
    "build": "npm run typecheck && tsx src/validate-catalog.ts && vite build",
    "preview": "vite preview",
    "format": "prettier --write src tests *.ts *.json index.html README.md"
  },
  "dependencies": {
    "@fontsource/vazirmatn": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.8",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
